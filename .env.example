# ============================================================
# EmotionLearnAI — Environment Variables Template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in your real values in .env
#   3. NEVER commit .env to git (it's in .gitignore)
# ============================================================

# ── Flask Security ────────────────────────────────────────────
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production

# ── Google Gemini AI ──────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
# Leave blank to disable AI question generation (static questions still work)
GEMINI_API_KEY=your-gemini-api-key-here

# ── Database ──────────────────────────────────────────────────
# Leave blank to use SQLite (local development default)
# For PostgreSQL: postgresql://username:password@host:5432/dbname
# Render example:  postgresql://user:pass@dpg-xxxx.oregon-postgres.render.com/emotionlearnai
DATABASE_URL=

# ── Rate Limiting Storage (optional) ─────────────────────────
# Leave blank to use in-memory (fine for single server)
# For production with multiple workers: redis://localhost:6379/0
REDIS_URL=

# ── Environment ───────────────────────────────────────────────
# Set to "production" on Render/Railway
FLASK_ENV=development
